# ==============================================================================
# NABIN PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env or .env.production and populate real secrets.
# NEVER commit populated .env files with production secrets to version control.

# Application Runtime Configuration
NODE_ENV=production
PORT=4000

# Authoritative Persistence Database (Supabase PostgreSQL)
# Required in production: Backend will FAIL CLOSED on startup if missing.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# In-Memory Real-Time / Telemetry Cache
REDIS_URL=redis://:<password>@<redis-host>:6379

# Platform URLs & Service Hosts
BETA_API_URL=https://api-beta.nabin.in
PROD_API_URL=https://api.nabin.in

# Deployment Webhook Endpoints (Configured in GitHub Secrets)
BETA_DEPLOY_WEBHOOK_URL=
PROD_DEPLOY_WEBHOOK_URL=
PROD_ROLLBACK_WEBHOOK_URL=

# Idempotency & Signature Secrets
WEBHOOK_SECRET=
JWT_SECRET=

# Razorpay Payment Gateway Configuration
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Cloudinary Public Media Storage & Delivery (Public Images/Videos Only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
