# NABIN PLATFORM — ISOLATED BETA ENVIRONMENT CONFIGURATION
NODE_ENV=beta
PORT=4000
BASE_URL=https://api-beta.nabin.in

# Supabase Beta Database & Auth
SUPABASE_URL=https://your-beta-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_beta_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_beta_service_role_key_here

# Redis Telemetry & Fast State Cache
REDIS_URL=redis://localhost:6379/1

# SMS / OTP Sandbox Provider (Beta Testing)
SMS_PROVIDER=TWILIO_SANDBOX
SMS_ACCOUNT_SID=your_twilio_beta_sid_here
SMS_AUTH_TOKEN=your_twilio_beta_auth_token_here
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# Payment Sandbox Provider
PAYMENT_GATEWAY=RAZORPAY_SANDBOX
RAZORPAY_KEY_ID=your_razorpay_beta_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_beta_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_razorpay_beta_webhook_secret_here

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY=your_firebase_beta_fcm_server_key_here
FCM_PROJECT_ID=nabin-beta-app

# Feature Flags Overrides
FEATURE_GROCERY=true
FEATURE_LIVE_TRACKING=true
FEATURE_DYNAMIC_PRICING=true
FEATURE_HIGH_FREQUENCY_REDIS=true
