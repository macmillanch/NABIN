# ==============================================================================
# NABIN — TESTING ENVIRONMENT, ALL TIERS  (Supabase project `nabin-test`)
#
# Project ref: ywhxkzmbwppkdemvzlhv   URL: https://ywhxkzmbwppkdemvzlhv.supabase.co
# This is the only project development, UI/UX verification, mock-to-real
# integration, schema/auth/OTP/realtime/storage/Edge Function testing and the
# automated suites may touch. It holds test rows, never production ones.
#
# Backend variables live with the backend: copy backend/.env.testing.example to
# backend/.env (or set them in the deployment platform). This file records how the
# rest of the product selects the same environment, so one environment name means
# the same thing in every tier.
# ==============================================================================

NODE_ENV=production
PORT=4000

# The public API host this environment is reached at. `ci_cd.yml` reads the same value
# from the BETA_API_URL secret to health-check and smoke-test a beta deploy.
API_URL=https://api-beta.nabin.in
# ---------------------------------------------------------------- the pin
# Read by backend/src/services/nabinEnv.js. A process that names `testing` but
# resolves a hosted URL, a connection string, or a key's project claim to any other
# ref — including the production one — stops at boot, and so does `npm run db:migrate`.
NABIN_ENV=testing
NABIN_SUPABASE_REF=ywhxkzmbwppkdemvzlhv
SUPABASE_URL=https://ywhxkzmbwppkdemvzlhv.supabase.co
# Server-side only. The service-role key never enters a browser bundle or a mobile build.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<user>:<password>@db.ywhxkzmbwppkdemvzlhv.supabase.co:5432/postgres
SUPABASE_POSTGRES_LIVE=true

# ---------------------------------------------------------------- web tier
# Each of admin-web, customer-web, grocery-merchant-web, restaurant-merchant-web reads
# exactly one variable, and it is browser-visible by design. They reach the Node
# backend, never Supabase directly — so no Supabase key of any kind belongs in here.
NEXT_PUBLIC_API_URL=https://api-beta.nabin.in/api

# ---------------------------------------------------------------- mobile tier
# The Flutter apps are configured at build time, not at runtime:
#   flutter build apk --dart-define=NABIN_ENV=testing \
#     --dart-define=NABIN_API_URL=https://api-beta.nabin.in/api \
#     --dart-define=NABIN_WS_URL=wss://api-beta.nabin.in
# A release build without NABIN_API_URL throws at startup rather than falling back to
# localhost, and a build that declares `production` refuses a non-production host.

# ---------------------------------------------------------------- what is NOT wired
# This template used to list variables no code reads, which invited the belief that
# the controls existed. They do not; each needs an implementation, not a value here:
#   SMS_PROVIDER / SMS_* / OTP_EXPIRY_SECONDS / OTP_RESEND_COOLDOWN_SECONDS
#     — OTP codes and their expiry are decided in database.js, not from env.
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET — the code reads PAYMENT_KEY_ID /
#     PAYMENT_KEY_SECRET / PAYMENT_WEBHOOK_SECRET.
#   FCM_SERVER_KEY / FCM_PROJECT_ID — the push provider reads FIREBASE_PROJECT_ID /
#     FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY / FIREBASE_SERVICE_ACCOUNT_KEY.
#   REDIS_URL / FEATURE_HIGH_FREQUENCY_REDIS — no Redis client in the backend.
#   ENABLE_RATE_LIMITING / MAX_OTP_ATTEMPTS_BEFORE_LOCKOUT / LOCKOUT_DURATION_MINUTES
#     / ENABLE_AUDIT_LOG_IMMUTABILITY — no implementation reads these.
#   FEATURE_GROCERY and the other feature flags come from the `settings` table
#     (`setting_key LIKE 'FEATURE_%'`), not from the environment.
