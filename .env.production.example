# ==============================================================================
# NABIN — PRODUCTION ENVIRONMENT, ALL TIERS  (Supabase project `NABIN`)
#
# Project ref: ouxvqmhuyueklnegvmxe   URL: https://ouxvqmhuyueklnegvmxe.supabase.co
# Real users, real authentication, real orders, rides, wallets and payments. Nothing
# in this file is a value to type into a development machine: a build that points here
# while naming any other environment is refused at boot, and so is a migration run.
#
# Backend variables live with the backend: copy backend/.env.production.example into the
# deployment platform (Render sets them as secrets; `sync: false` in render.yaml means
# the dashboard owns the value, this file owns only the name).
# ==============================================================================

NODE_ENV=production
PORT=4000

# The public API host production is reached at, and the host the admin notification
# links point at. `ci_cd.yml` reads PROD_API_URL to health-check and smoke-test a
# production deploy, and rolls back if `/api/health` or `/api/ready` does not answer 200.
API_URL=https://api.nabin.in
ADMIN_DASHBOARD_URL=https://admin.nabin.in

# ---------------------------------------------------------------- the pin
NABIN_ENV=production
NABIN_SUPABASE_REF=ouxvqmhuyueklnegvmxe
SUPABASE_URL=https://ouxvqmhuyueklnegvmxe.supabase.co
# Only the publishable/anonymous key may reach a browser or a mobile build, and only
# because RLS decides what an anon request can read. The service-role key is server-side:
# it appears in no client source, no NEXT_PUBLIC_ variable, no bundle and no repository.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<user>:<password>@db.ouxvqmhuyueklnegvmxe.supabase.co:5432/postgres
SUPABASE_POSTGRES_LIVE=true

# Required in production. Without it the service-role client would fall back to the
# anon key and privileged writes would be answered by RLS as `anon`.
# (Enforced by src/supabase.js, refused by src/services/nabinEnv.js.)

# ---------------------------------------------------------------- web tier
# admin-web, customer-web, grocery-merchant-web, restaurant-merchant-web each read one
# browser-visible variable and reach the Node backend, never Supabase directly.
NEXT_PUBLIC_API_URL=https://api.nabin.in/api

# ---------------------------------------------------------------- mobile tier
#   flutter build apk --dart-define=NABIN_ENV=production \
#     --dart-define=NABIN_API_URL=https://api.nabin.in/api \
#     --dart-define=NABIN_WS_URL=wss://api.nabin.in
# A release build without NABIN_API_URL throws at startup instead of falling back to
# localhost, and a build that declares `production` refuses a host that is not the
# production one.

# ---------------------------------------------------------------- what is NOT wired
# This template used to list variables no code reads, which invited the belief that
# the controls existed. They do not; each needs an implementation, not a value here:
#   SMS_PROVIDER / SMS_AUTH_KEY / SMS_SENDER_ID / OTP_EXPIRY_SECONDS /
#     OTP_RESEND_COOLDOWN_SECONDS — OTP codes and expiry live in database.js.
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET — the code reads PAYMENT_KEY_ID /
#     PAYMENT_KEY_SECRET / PAYMENT_WEBHOOK_SECRET.
#   FCM_SERVER_KEY / FCM_PROJECT_ID — the push provider reads FIREBASE_PROJECT_ID /
#     FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY / FIREBASE_SERVICE_ACCOUNT_KEY.
#   REDIS_URL — no Redis client in the backend.
#   ENABLE_RATE_LIMITING / MAX_OTP_ATTEMPTS_BEFORE_LOCKOUT / LOCKOUT_DURATION_MINUTES
#     / ENABLE_AUDIT_LOG_IMMUTABILITY — no implementation reads these.
#   Feature availability comes from the `settings` table (`setting_key LIKE 'FEATURE_%'`),
#     not from the environment.
