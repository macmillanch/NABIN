# NABIN PLATFORM — ISOLATED PRODUCTION ENVIRONMENT CONFIGURATION
NODE_ENV=production
PORT=4000
BASE_URL=https://api.nabin.in

# Supabase Production Database & Auth (Zero-Trust Master DB)
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_prod_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_prod_service_role_key_here

# Redis Telemetry & Fleet Tracking Cluster
REDIS_URL=rediss://your-prod-redis-cluster.nabin.in:6379/0

# Production SMS / OTP Provider (Guaranteed Delivery)
SMS_PROVIDER=MSG91_PRODUCTION
SMS_AUTH_KEY=your_msg91_prod_auth_key_here
SMS_SENDER_ID=NABININ
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# Production Payment Gateway (Live Banking Rails)
PAYMENT_GATEWAY=RAZORPAY_PRODUCTION
RAZORPAY_KEY_ID=your_razorpay_live_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_live_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_razorpay_live_webhook_secret_here

# Production Firebase Cloud Messaging
FCM_SERVER_KEY=your_firebase_prod_fcm_server_key_here
FCM_PROJECT_ID=nabin-master-production

# Security & Compliance
ENABLE_RATE_LIMITING=true
MAX_OTP_ATTEMPTS_BEFORE_LOCKOUT=3
LOCKOUT_DURATION_MINUTES=15
ENABLE_AUDIT_LOG_IMMUTABILITY=true
