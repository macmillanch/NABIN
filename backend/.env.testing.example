# ==============================================================================
# NABIN BACKEND — TESTING / DEVELOPMENT HOSTED (Supabase project `nabin-test`)
# Copy to backend/.env on a machine or CI job that must exercise the real hosted
# stack: UI/UX verification, mock-to-real integration, schema, auth, OTP, realtime,
# storage and Edge Function testing, and automated suites.
#
# This project holds TEST data only — test customers, drivers, merchants, orders,
# rides, wallets and transactions. It never holds production customer, payment or
# authentication data, and nothing here may be copied out of production unless the
# owner has authorised it and the rows are anonymised first.
#
# Keys are values you set from the Supabase dashboard for THIS project. Never
# commit them, never print them, never put the service-role key in a client build.
# ==============================================================================

PORT=4000

# `testing` may still run NODE_ENV=production (that is how the beta service is
# deployed today) because hardened code paths should be exercised before release.
# What src/services/nabinEnv.js refuses is the opposite pairing — production data
# served by a process that still allows fixed OTP codes.
NODE_ENV=production

# ---------------------------------------------------------------- the pin
# The single project this environment owns. Every hosted ref the process can
# reach — SUPABASE_URL, DATABASE_URL, and the project encoded in each key's `iss`
# claim — must equal this, or the backend and the migration runner refuse to start.
NABIN_ENV=testing
NABIN_SUPABASE_REF=ywhxkzmbwppkdemvzlhv

SUPABASE_URL=https://ywhxkzmbwppkdemvzlhv.supabase.co
# Publishable/anonymous client key for `nabin-test`. Server-side use here; any
# client-facing copy must be the same anon key, never the service-role one.
SUPABASE_ANON_KEY=
# Server-side only. Required: without it the service-role client would silently
# fall back to the anon key and every privileged write would be answered by RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler or direct connection for `nabin-test` — never the transaction
# pooler, DDL needs a session. Must name the same project as SUPABASE_URL.
DATABASE_URL=postgresql://postgres.<user>:<password>@db.ywhxkzmbwppkdemvzlhv.supabase.co:5432/postgres
DATABASE_SSL=require
SUPABASE_POSTGRES_LIVE=true

MIGRATIONS_DIR=

ADMIN_BOOTSTRAP_SECRET=
# The dashboard link included in admin-facing notifications. Set it to whatever host
# the beta admin-web is served from; the code default is https://admin.nabin.in.
ADMIN_DASHBOARD_URL=

# Sandbox rails only. A testing environment must never carry live payment
# credentials, and a test webhook secret is not a production webhook secret.
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Media. Cloudinary credentials are per-project, so a distinct cloud (or at least a
# distinct folder prefix at the call site) is what keeps a test upload off a
# production listing — there is no folder-namespace variable to set here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Test Firebase project for push, so a development build can never address a
# production user's device. Empty falls back to the sandbox provider.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

APP_CONFIG_CACHE_SECONDS=5
