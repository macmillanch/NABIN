# ==============================================================================
# NABIN BACKEND — LOCAL DEVELOPMENT (Docker Supabase)
# Copy to backend/.env. This is the stack the repo runs day to day: nothing here
# reaches a hosted project, so no project pin is required.
#
#   supabase start          # api http://127.0.0.1:54321, db 127.0.0.1:54322
#   npm run db:migrate
#   npm run dev
#
# NEVER put a hosted project's keys in this file. The hosted environments have
# their own templates: .env.testing.example (nabin-test) and
# .env.production.example (NABIN). See docs/SUPABASE_ENVIRONMENTS.md.
# ==============================================================================

PORT=4000
NODE_ENV=development

# Which environment this process is, and the one Supabase project it may touch.
# Loopback needs no NABIN_SUPABASE_REF; a hosted target does, and the boot refuses
# without it (src/services/nabinEnv.js).
NABIN_ENV=development

# Local Docker Supabase ships well-known demo keys. They are not credentials —
# they only ever work against 127.0.0.1.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=paste-the-local-anon-key-from-supabase-start-output
SUPABASE_SERVICE_ROLE_KEY=paste-the-local-service-role-key-from-supabase-start-output

# Direct PostgreSQL connection used only by `npm run db:migrate` (container start).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# TLS for db:migrate. For a local DSN the policy sends no TLS whatever this says, so leaving
# it empty is correct here. For a hosted target only `require` (or `verify-full` / `true`, or
# unset, which means the same) is accepted: `no-verify`, `insecure` and `allow` are refused
# with `DATABASE_TLS_BYPASS_REFUSED`, `disable` and `false` with the plain-text variant of that
# same refusal, and anything else as `DATABASE_TLS_MODE_UNKNOWN` — `src/services/dbTls.js`.
DATABASE_SSL=

# True here means "the local Docker Postgres is the store", not "a hosted project".
SUPABASE_POSTGRES_LIVE=true

# Seed the local in-memory/Postgres store with demo rows so the apps have data to
# read. Never set in a hosted environment.
ADMIN_BOOTSTRAP_SECRET=
ADMIN_DASHBOARD_URL=http://localhost:3001

# Payment provider credentials. Sandbox in every environment except a live release.
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Media storage for proof-of-delivery and KYC uploads. Keep a separate Cloudinary
# folder per environment so a test upload cannot appear on a production listing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications. No Firebase project is configured yet; the provider falls back
# to the sandbox when these are empty. Supabase remains the backend — Firebase is
# only ever a delivery channel.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

APP_CONFIG_CACHE_SECONDS=60

# SMS Gateway (OTP dispatch) — BLK-03
# In development the provider defaults to CONSOLE (logs to stdout, no network).
# In production SMS_PROVIDER is required. Absent → 503 SMS_GATEWAY_NOT_CONFIGURED.
#
# India DLT (TRAI): register at Vilpower / Jio / Airtel / Smartping. Approx 5-7 day lead time.
# OTP template: "Your NABIN verification code is {otp}. Valid for 5 minutes. Do not share this OTP."
#
SMS_PROVIDER=CONSOLE
# --- FAST2SMS (India DLT transactional route) ---
FAST2SMS_API_KEY=
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=
DLT_SENDER_ID=NABINM
# --- Twilio (international / non-India fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# --- Custom template (optional, must match DLT-approved text exactly in production) ---
NABIN_SMS_TEMPLATE=Your NABIN verification code is {otp}. Valid for 5 minutes. Do not share this OTP.

# --- Restaurant dine-in QR (RMS) ---
# The public origin a table's QR link is built from (RestaurantManagementRepository.js
# diningQrUrl()). Only restaurant_tables.qr_code_token is stored — the URL is composed from this
# value on every read. Empty → http://localhost:3000, which is correct for a local checkout and
# useless on a sticker: it would ask the diner's phone to open the diner's own machine. A
# deployment sets this to its public customer-web origin.
DINING_QR_BASE_URL=
