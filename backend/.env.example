# NABIN Platform Environment Variables
PORT=4000
NODE_ENV=development

# Supabase Credentials (Get these from your Supabase Dashboard: Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection used only by `npm run db:migrate` (container start).
# Supabase: Project Settings -> Database -> Connection string. Use the session pooler
# or direct connection, never the transaction pooler (DDL needs a session).
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# TLS for db:migrate only: disable | no-verify | require. Unset means auto-detect
# (no TLS for localhost / private LAN hosts, verified TLS everywhere else).
DATABASE_SSL=

# Required for production so migrations run against the same project the API reads.
SUPABASE_POSTGRES_LIVE=true

# App JWT Secret
JWT_SECRET=nabin_super_secure_jwt_secret_2026
ADMIN_BOOTSTRAP_SECRET=

# Payment provider credentials. Set unique values in the deployment environment.
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Media storage for proof-of-delivery and KYC uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
