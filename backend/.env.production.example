# ==============================================================================
# NABIN BACKEND — PRODUCTION (Supabase project `NABIN`)
# Copy to backend/.env only inside the production deployment. Real users, real
# auth, real orders, real payments. A development or testing build must never be
# pointed at these values, and nothing here may be copied into a test environment
# unless the owner has authorised it and the rows are anonymised first.
#
# This file is a template: every key value is blank by design. Keys are set by the
# deployment platform (Render), never committed, and never printed in a log.
# ==============================================================================

PORT=4000
NODE_ENV=production

# ---------------------------------------------------------------- the pin
# src/services/nabinEnv.js makes this pairing structural: NABIN_ENV=production
# with a URL or key that resolves to any other project — including the test one —
# stops the process before it opens a socket, and so does the migration runner.
# NODE_ENV must also be production here, or the process would serve live data while
# still honouring fixed OTP codes.
NABIN_ENV=production
NABIN_SUPABASE_REF=ouxvqmhuyueklnegvmxe

SUPABASE_URL=https://ouxvqmhuyueklnegvmxe.supabase.co
# Publishable/anonymous client key for the production project. This is the only
# Supabase credential that may reach a browser or a mobile build, and only with
# RLS enabled. It is not a bypass: RLS decides what an anon request can read.
SUPABASE_ANON_KEY=
# Server-side only. Required in production; privileged writes must not fall back to
# the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler or direct connection for the production project — never the
# transaction pooler, DDL needs a session. Must name the same project as SUPABASE_URL.
DATABASE_URL=postgresql://postgres.<user>:<password>@db.ouxvqmhuyueklnegvmxe.supabase.co:5432/postgres
DATABASE_SSL=require
SUPABASE_POSTGRES_LIVE=true

MIGRATIONS_DIR=

ADMIN_BOOTSTRAP_SECRET=
ADMIN_DASHBOARD_URL=https://admin.nabin.in

# Payment rails. `repositories/PaymentRepository.js` treats PAYMENT_MODE=live as the
# switch to real rails; the production service currently runs sandbox, so this stays
# sandbox until live keys are provisioned in the deployment — never in a file.
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Production media cloud. Keep it distinct from the testing cloud so a test upload
# can never appear on a live listing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production Firebase project for push only, so a development build can never
# address a production user's device. Supabase stays the backend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

APP_CONFIG_CACHE_SECONDS=300
