# ==============================================================================
# NABIN PLATFORM — SANITIZED STAGING ENVIRONMENT TEMPLATE
# File: backend/.env.staging.example
# Copy to: backend/.env.staging   (gitignored by `.env.*`; never commit a filled copy)
# ==============================================================================
# WHAT THIS TARGET IS
#
# "Staging" is the hosted `nabin-test` project, ref `ywhxkzmbwppkdemvzlhv` — the same
# project docs/SUPABASE_ENVIRONMENTS.md calls `testing`. There is no third hosted project.
# This file exists because `scripts/with_staging_target.js` reads `backend/.env.staging`
# by default when it wraps a command:
#
#   node scripts/with_staging_target.js node scripts/migrate.js
#
# The production project is `ouxvqmhuyueklnegvmxe`. It must never appear in this file: the
# staging harness refuses that ref, the boot guard (`src/services/nabinEnv.js`) refuses a
# key whose own project claim disagrees, and no test or migration is authorised against it.
#
# WHY THE VALUES BELOW ARE WHAT THEY ARE
#
# Every line is a shape the guards accept, measured on 12 Oct 2026 with
# `node staging_target_guard_test.js` (40 checks) and by running the harness CLI on a copy
# of this template. An earlier revision of this file failed those guards: putting its own
# values through `nabinEnv.audit` returned 3 problems — `NABIN_ENV="staging" is not one of
# development | testing | production`, `NABIN_SUPABASE_REF="your-staging-project-ref-here" is
# not a 20-character Supabase project ref`, and a `SUPABASE_URL` that is "a hosted host with no
# project ref in it, so it cannot be checked" against the declared ref — so a copied template
# could not have booted at all. Its `:6543` connection string was no guard's business, but it
# was still wrong: see the DATABASE_URL note below.
# ==============================================================================

# `staging` is not an environment name. `nabinEnv.ENVIRONMENTS` is
# development | testing | production, so NABIN_ENV=staging fails the boot audit.
NABIN_ENV=testing

# `testing` runs production code paths — that is how the beta service is deployed, and it is
# what keeps fixed test OTPs gated off (`RuntimeMode`). The staging harness rewrites
# NODE_ENV=staging to production for the same reason.
NODE_ENV=production

# ---------------------------------------------------------------- the pin
# The one project this environment owns. SUPABASE_URL, DATABASE_URL and both keys below have
# to name it too. The harness refuses any other ref unless the operator says so explicitly
# with NABIN_ALLOW_STAGING_REF=<ref> on the command line.
NABIN_SUPABASE_REF=ywhxkzmbwppkdemvzlhv
SUPABASE_URL=https://ywhxkzmbwppkdemvzlhv.supabase.co

# Client and server keys for THIS project, from Dashboard → Project Settings → API.
# Blank here on purpose: the harness reports a missing key as "Missing required staging
# configuration keys", while a template string like `your-staging-anon-key-here` is refused
# as an unfilled credential. Both are true; the blank is the shorter error to read.
# Each legacy key carries its project in a top-level `ref` claim, and that claim is decoded
# and compared — a production service key pasted here is caught from the credential side.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- the database
# SESSION pooler (`:5432`), ref in the username. Not the transaction pooler (`:6543`):
# `scripts/migrate.js` serialises itself with `pg_try_advisory_lock(hashtext(...))`, which is
# session state, and a pooler that resets state between statements cannot hold it.
# The password slot below is deliberately a marker the harness recognises; see "OWNER ACTION"
# at the bottom of this file.
DATABASE_URL=postgresql://postgres.ywhxkzmbwppkdemvzlhv:PASTE_YOUR_DATABASE_PASSWORD_HERE@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Verified TLS. No `sslmode=` query parameter: node-postgres ignores it, and TLS is decided
# in code by `src/services/dbTls.js` (see scripts/migrate.js). `DATABASE_SSL=no-verify` (or
# `insecure` / `allow`) is refused outright — `DATABASE_TLS_BYPASS_REFUSED` — because it would
# send database credentials without checking the certificate. The trust anchor for a hosted
# Supabase target is the pinned `backend/certs/supabase-root-2021-ca.pem`; override the file
# with DATABASE_SSL_CA_FILE only if Supabase rotates the root.
DATABASE_SSL=require

# Postgres is the write path for this target. With it unset the backend answers from the
# in-memory/JSON store, which is a development convenience and not staging behaviour.
SUPABASE_POSTGRES_LIVE=true

# ---------------------------------------------------------------- server
PORT=4000
# There is no CORS_ORIGIN variable: `src/server.js` holds the origin allowlist in code, so
# adding a staging web origin is a source change and a review, not a line in this file.

# ---------------------------------------------------------------- rails that must stay sandboxed
PAYMENT_MODE=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Media. Cloudinary credentials are per-project; a distinct cloud (or folder prefix at the
# call site) is what keeps a staging upload off a production listing. There is no
# CLOUDINARY_FOLDER variable to set here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push. Empty Firebase credentials fall back to the sandbox provider; the provider is chosen
# by the presence of these values, not by NABIN_ENV, so staging must not carry production ones.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

ADMIN_BOOTSTRAP_SECRET=
ADMIN_DASHBOARD_URL=https://admin.nabin.in

# ==============================================================================
# OWNER ACTION (the one thing that blocks a hosted staging run)
#
# The two refusal texts below are measured, not imagined: `node
# staging_target_guard_test.js` runs 40 checks over this path, and the same target map was
# put through `establishStagingTarget` on 12 Oct 2026 — once with this file's blank keys, once
# with the keys filled and the password slot untouched (the state `backend/.env.staging` is in
# right now). The values alone produce 0 problems and 0 notes under `nabinEnv.audit`.
#
# Copied as-is, with no keys:
#   REFUSED — staging target could not be established: Missing required staging
#   configuration keys: SUPABASE_SERVICE_ROLE_KEY
#
# Keys pasted, password slot left as the marker above — the harness exits 2 and spawns
# nothing:
#   REFUSED — staging target could not be established: DATABASE_URL still holds an unfilled
#   template value (matched by shape; the value is not printed). Owner action: Supabase
#   Dashboard → Project Settings → Database → Database Password for project
#   ywhxkzmbwppkdemvzlhv, then paste it into the staging env file.
#
# Until that password is pasted into `backend/.env.staging`, no migration, seed or hosted
# integration test can run against staging. Nothing in this repository can obtain it, and
# inventing one is not an option: it would fail as a `28P01` authentication error several
# layers away from the cause.
# ==============================================================================
