# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.beta.example
!.env.production.example
# Any `*.example` template stays committable at any depth — backend/.env.testing.example
# and backend/.env.production.example are per-environment templates, and `.env.*` above
# would otherwise swallow them and the templates would exist only on one machine.
!.env.*.example
.env.local
.env.development.local
.env.test.local
.env.production.local

